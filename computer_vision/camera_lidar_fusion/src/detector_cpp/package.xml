<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>detector_cpp</name>
  <version>0.1.0</version>
  <description>2D object detector for the KITTI left color camera: YOLO11n through ONNX Runtime (C++), with letterbox, decode and NMS done in the package.</description>
  <maintainer email="noahhouse417@gmail.com">Noah House</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ONNX Runtime (onnxruntime-cpp) comes from pixi; it has no rosdep key. -->
  <depend>libopencv-dev</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
