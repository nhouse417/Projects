<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kitti_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and the RViz2 config for the KITTI camera-LiDAR fusion pipeline: bag playback, the nodes, and visualization.</description>
  <maintainer email="noahhouse417@gmail.com">Noah House</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>vision_msgs_rviz_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
